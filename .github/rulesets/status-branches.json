{
  "name": "status-branches",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {"include": ["refs/heads/status/**"], "exclude": []}
  },
  "rules": [{"type": "deletion"}, {"type": "non_fast_forward"}],
  "bypass_actors": [
    {"actor_type": "RepositoryRole", "actor_id": 5, "bypass_mode": "pull_request"}
  ]
}
