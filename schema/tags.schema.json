{
  "$id": "https://homalg-db/schema/tags.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tags": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "$ref": "common.schema.json#/$defs/SlugId"
          },
          "label": {
            "type": "string"
          },
          "merged_into": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common.schema.json#/$defs/SlugId"
              }
            ]
          },
          "msc": {
            "items": {
              "pattern": "^[0-9]{2}[A-Z]?[0-9]{0,2}$",
              "type": "string"
            },
            "type": "array"
          },
          "parent": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common.schema.json#/$defs/SlugId"
              }
            ]
          }
        },
        "required": [
          "id",
          "label",
          "parent"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "tags"
  ],
  "type": "object"
}
