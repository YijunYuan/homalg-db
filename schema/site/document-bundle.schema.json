{
  "$id": "https://homalg-db/schema/site/document-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chapters": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "chapter": {
            "type": "string"
          },
          "node_ids": {
            "items": {
              "$ref": "../common.schema.json#/$defs/NodeId"
            },
            "type": "array"
          },
          "sections": {
            "$ref": "../document.schema.json#/properties/structure/items/properties/sections"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "chapter",
          "sections",
          "node_ids"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "document": {
      "allOf": [
        {
          "$ref": "../document.schema.json"
        }
      ],
      "properties": {
        "bibtex": false
      }
    },
    "edges": {
      "items": {
        "$ref": "common.schema.json#/$defs/Edge"
      },
      "type": "array"
    },
    "external_nodes": {
      "items": {
        "$ref": "common.schema.json#/$defs/NodeRef"
      },
      "type": "array"
    },
    "layout": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "nodes": {
              "additionalProperties": {
                "$ref": "common.schema.json#/$defs/Point"
              },
              "propertyNames": {
                "$ref": "../common.schema.json#/$defs/NodeId"
              },
              "type": "object"
            },
            "options_hash": {
              "$ref": "../common.schema.json#/$defs/Hash64"
            },
            "view": {
              "const": "aux-collapsed"
            }
          },
          "required": [
            "view",
            "nodes",
            "options_hash"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "nodes": {
      "items": {
        "$ref": "common.schema.json#/$defs/NodeSummary"
      },
      "type": "array"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "document",
    "chapters",
    "nodes",
    "edges",
    "external_nodes"
  ],
  "type": "object"
}
